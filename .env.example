# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual credentials (see PROJECT-RULES.md: never hard-code
# API keys, passwords, broker secrets, or tokens).

POSTGRES_DB=trading_system
POSTGRES_USER=trading_system
POSTGRES_PASSWORD=changeme
# Not 5432: on machines with a pre-existing local Postgres install,
# that will already own 5432. Change if 5433 is also taken.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# SQLAlchemy connection string used by the app/Alembic (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://trading_system:changeme@localhost:5433/trading_system

# The test suite runs against DATABASE_URL + "_test" appended to the
# database name (see backend/app/config.py::test_database_url) - a
# separate database, not just a separate transaction, so tests never
# see real ingestion data. One-time setup after starting Postgres:
#   docker exec trading-system-postgres psql -U trading_system -d trading_system -c "CREATE DATABASE trading_system_test;"
#   DATABASE_URL=postgresql+psycopg://trading_system:<password>@localhost:5433/trading_system_test uv run alembic upgrade head

# ---------------------------------------------------------------------------
# Options data-provider credentials (O1.0 revised gate, 2026-09-22).
# ALL OPTIONAL. Nothing in the codebase requires these to run; they are read
# only by backend/app/data/sources/provider_credentials.py and the
# scripts/run_o1_verify_<provider>.py verification scripts, which report a
# clear "not configured" message (not a crash) when a block below is empty.
# Never commit real values here - this file is the template; put real values
# only in your local, gitignored .env.

# Upstox: needs a Plus-plan subscription for the Expired Instruments APIs.
# UPSTOX_ACCESS_TOKEN is a bearer token from Upstox's interactive OAuth login
# (https://api.upstox.com/v2/login/authorization/dialog -> code -> POST
# https://api.upstox.com/v2/login/authorization/token); that exchange is
# interactive (browser login) and is NOT automated here - obtain the token
# yourself (Upstox's dashboard also offers a manual/semi-automated flow) and
# paste the resulting token. Undocumented lifetime; expect to regenerate it
# periodically.
# UPSTOX_ACCESS_TOKEN=

# Dhan (DhanHQ v2): Data API subscription (~Rs 499/month, or free with 25
# trades in the last 30 days). Generate both via Dhan web: Profile ->
# DhanHQ Trading APIs. DHAN_ACCESS_TOKEN is valid for 24 hours only
# (regenerate daily) unless you use the separate API-key based flow Dhan
# documents for longer-lived tokens.
# DHAN_CLIENT_ID=
# DHAN_ACCESS_TOKEN=

# ICICI Direct Breeze API: free, needs an ICICI Direct trading account.
# BREEZE_API_KEY / BREEZE_API_SECRET come from registering an app at
# api.icicidirect.com. BREEZE_SESSION_TOKEN is obtained by visiting
# https://api.icicidirect.com/apiuser/login?api_key=<url-encoded BREEZE_API_KEY>,
# logging in, and copying the API_Session value from the redirect URL - this
# expires at midnight IST, so it must be regenerated once per trading day.
# BREEZE_API_KEY=
# BREEZE_API_SECRET=
# BREEZE_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# reads/uses any Dhan or database credential above - it only reads DATABASE_URL
# (already configured above) via the existing SQLAlchemy session.

# Optional shared-secret gate for the API (X-API-Key header). If unset, auth is
# DISABLED - the accepted default for local/internal development only; set this
# MONITORING_API_KEY=

# Comma-separated CORS origin allowlist for the future frontend. Defaults to
# common local dev-server ports (localhost:3000/5173) if unset - never a wildcard.
# MONITORING_UI_ORIGINS=http://localhost:3000,http://localhost:5173
